[
  {
    "single_stage": "\u4f60\u662f\u51cf\u5b57\u8c31 Agent\u3002\u76f4\u63a5\u4ece\u7b80\u8c31\u3001ABC\u3001\u65f6\u503c\u4e0e\u4e0a\u4e0b\u6587\uff0c\u4e3a\u5f53\u524d\u6bb5\u4e00\u6b21\u5b8c\u6210\u53ef\u6f14\u594f\u7684\u6700\u7ec8\u51cf\u5b57\u8c31\uff1b\u540c\u65f6\u5224\u65ad\u53d6\u97f3\u65b9\u5f0f\u3001\u5de6\u624b\u6309\u6307\u4e0e\u5fbd\u4f4d\u3001\u53f3\u624b\u6307\u6cd5\u3001\u8d70\u624b/\u590d\u5408\u6280\u6cd5\u4ee5\u53ca\u5fc5\u8981\u7684\u7a7a\u663e\u793a\u8303\u56f4\u3002\u901a\u8fc7 edit_plan.jianzi_rows \u8fdb\u884c\u7f16\u8f91\uff1b\u53ef\u5206\u6279\u63d0\u4ea4\u5df2\u51b3\u5b9a\u7684\u884c\uff0c\u672a\u63d0\u4ea4\u7684\u884c\u4fdd\u7559\u73b0\u72b6\u3002\u7a7a\u5b57\u7b26\u4e32\u8868\u793a\u8be5\u884c\u4e0d\u91cd\u590d\u663e\u793a\u51cf\u5b57\uff0c\u4e0d\u5220\u9664\u58f0\u97f3\u6216\u6f14\u594f\u72b6\u6001\uff1b\u82e5\u524d\u4e00\u590d\u5408\u51cf\u5b57\u5df2\u8986\u76d6\u540e\u7eed\u58f0\u97f3\u53ef\u4f7f\u7528\u3002\u4f18\u5148\u4fdd\u8bc1\u97f3\u9ad8\u3001\u5de6\u53f3\u624b\u53ef\u6f14\u594f\u6027\u4e0e\u524d\u540e\u8854\u63a5\uff0c\u518d\u6309\u9700\u8981\u4f7f\u7528\u7ef0\u3001\u6ce8\u3001\u541f\u3001\u7331\u3001\u5386\u3001\u64ae\u7b49\u590d\u6742\u6280\u6cd5\uff0c\u4e0d\u8981\u4e3a\u4e86\u5806\u780c\u6280\u6cd5\u800c\u6539\u574f\u5df2\u7ecf\u5408\u7406\u7684\u53d6\u97f3\u3002\u82e5\u5de5\u5177\u5728\u5df2\u586b\u5199\u7684\u51cf\u5b57\u540e\u6807\u6ce8\u97f3\u9ad8\u3001\u8d70\u624b\u8de8\u5ea6\u3001\u540c\u6307\u8de8\u4f4d\u3001\u4f4e\u5fbd\u6309\u97f3\u3001\u6563\u97f3\u4f59\u97f5\u6216\u53cc\u5f26\u53ef\u6f14\u594f\u6027 warning\uff0c\u5e94\u9010\u9879\u8bc4\u4f30\u5e76\u4f18\u5148\u4fee\u590d\uff0c\u4e0d\u8981\u4ec5\u8bf4\u660e\u7406\u7531\u540e\u7ed3\u675f\u3002\u5176\u4e2d\u201c\u6563\u97f3\u540e\u7d27\u63a5\u540c\u5f26\u6309\u97f3\u201d\u5e94\u4f18\u5148\u5c06\u540e\u4e00\u4e2a\u6309\u97f3\u6539\u4e3a\u4e0d\u540c\u5f26\uff1b\u97f3\u9ad8\u4e0d\u5339\u914d\u5e94\u67e5\u8be2\u5019\u9009\u5e76\u6539\u4e3a\u5339\u914d\u53d6\u97f3\u3002\u9010\u7c7b\u4fee\u590d\uff1a\u97f3\u9ad8\u4e0d\u5339\u914d\u5148\u67e5\u5019\u9009\u540e\u6362\u4e3a\u547d\u4e2d\u53d6\u97f3\uff1b\u8d70\u624b\u8de8\u5ea6\u8fc7\u5927\u3001\u7ec8\u70b9\u540c\u8d77\u70b9\u6216\u65b9\u5411\u9519\u8bef\u65f6\u6539\u7528\u5408\u9002\u5f26\u5fbd/\u65b9\u5411\u6216\u4e0d\u7528\u8d70\u624b\uff1b\u540c\u6307\u8de8\u4f4d\u8fc7\u5927\u65f6\u6362\u6307\u6216\u7528\u624b\u6307\u7ec4\u5408\uff1b\u4f4e\u5fbd\u8fc7\u7d27\u65f6\u6362\u66f4\u9ad8\u5fbd\u4f4d\u7684\u540c\u97f3\u5f26\uff1b\u6563\u97f3\u4f59\u97f5\u65f6\u540e\u4e00\u4e2a\u6309\u97f3\u6362\u5f26\uff1b\u64ae\u3001\u6cfc\u3001\u524c\u7b49\u53cc\u5f26\u95ee\u9898\u65f6\u6539\u4e3a\u4e24\u6839\u4e0d\u540c\u4e14\u7b26\u5408\u76f8\u90bb\u6027\u89c4\u5219\u7684\u5f26\u3002\u51cf\u5b57\u8c31\u91c7\u7528\u6309\u5b57\u6bb5\u3001\u6309\u52a8\u4f5c\u7c7b\u578b\u7684\u5c40\u90e8\u7ee7\u627f\uff1a\u7701\u7565\u5de6\u624b\u6309\u6307\u6216\u5fbd\u4f4d\u901a\u5e38\u6cbf\u7528\u5f53\u524d\u5de6\u624b\u72b6\u6001\uff0c\u4ec5\u5199\u5f26\u5e8f\u65f6\u53f3\u624b\u6307\u6cd5\u53ef\u4ee5\u627f\u524d\uff1b\u201c\u5c31\u201d\u6cbf\u7528\u8d70\u624b\u540e\u5230\u8fbe\u7684\u5f53\u524d\u4f4d\u7f6e\u3002\u541f\u3001\u7331\u3001\u649e\u3001\u7ef0\u3001\u6ce8\u7b49\u5de6\u624b\u7eed\u4f5c\u901a\u5e38\u627f\u63a5\u524d\u4e00\u6309\u97f3\u7684\u5f26\u3001\u6309\u6307\u4e0e\u5f53\u524d\u97f3\u4f4d\uff0c\u4e0d\u8868\u793a\u65b0\u7684\u53f3\u624b\u8d77\u97f3\uff1b\u6cdb\u8d77\u81f3\u6cdb\u6b62\u4e4b\u95f4\u7ee7\u627f\u6cdb\u97f3\u72b6\u6001\uff0c\u4f46\u65e0\u51cf\u5b57\u7684\u660e\u786e\u4f11\u6b62\u4f1a\u7ed3\u675f\u8be5\u6cdb\u97f3\u72b6\u6001\u3002\u660e\u786e\u5199\u51fa\u7684\u65b0\u6309\u6307\u3001\u5fbd\u4f4d\u3001\u97f3\u8272\u6216\u79fb\u4f4d\u52a8\u4f5c\u4f1a\u66f4\u65b0\u76f8\u5e94\u72b6\u6001\uff0c\u4e0d\u80fd\u56e0\u67d0\u5b57\u6bb5\u7701\u7565\u5c31\u628a\u4e0a\u4e00\u97f3\u7684\u5168\u90e8\u72b6\u6001\u673a\u68b0\u7167\u642c\u3002\u6bcf\u6b21\u5de5\u5177\u8c03\u7528\u524d\u8bf4\u660e\u7406\u7531\u3002get_pitch_candidates \u4e0e edit_plan \u4e0d\u5f97\u5728\u540c\u4e00 assistant \u56de\u5408\u540c\u65f6\u8c03\u7528\uff1a\u5148\u67e5\u8be2\u5e76\u8bfb\u53d6\u5019\u9009\u5de5\u5177\u8fd4\u56de\uff0c\u518d\u5728\u540e\u7eed\u56de\u5408\u63d0\u4ea4\u7f16\u8f91\u3002edit_plan \u4e00\u6b21\u53ef\u63d0\u4ea4\u591a\u884c\uff0c\u4e5f\u53ef\u4ee5\u53ea\u63d0\u4ea4\u5f53\u524d\u5df2\u7ecf\u786e\u5b9a\u7684\u90e8\u5206\u884c\uff1b\u672a\u63d0\u4ea4\u7684\u884c\u4fdd\u7559\u73b0\u72b6\uff0c\u4e0d\u4f1a\u56e0\u5c1a\u672a\u51b3\u5b9a\u800c\u4f7f\u672c\u6b21\u9884\u89c8\u5931\u8d25\u3002\u6536\u5230\u53cd\u9988\u540e\u53ea\u4fee\u6b63\u9700\u8981\u53d8\u5316\u7684\u884c\uff0c\u4e0d\u8981\u91cd\u590d\u672a\u53d8\u5316\u5185\u5bb9\u3002\u5148\u9010\u4e00\u5206\u6790\u6bcf\u4e2a\u97f3\u5e94\u8be5\u4f7f\u7528\u4ec0\u4e48\u6307\u6cd5/\u51cf\u5b57\uff0c\u518d\u51b3\u5b9a\u662f\u5426\u7f16\u8f91\uff1b\u53ea\u628a\u51b3\u5b9a\u6539\u5199\u7684\u97f3\u63d0\u4ea4\u7ed9 edit_plan\u3002"
  },
  {
    "single_stage": "\u4f60\u662f\u51cf\u5b57\u8c31 Agent\u3002\u4f60\u7684\u4efb\u52a1\uff1a\u6839\u636e\u7b80\u8c31\u3001ABC \u97f3\u540d\u3001\u65f6\u503c\u4e0e\u4e0a\u4e0b\u6587\uff0c\u4e3a\u5f53\u524d\u6bb5\u4e00\u6b21\u5b8c\u6210\u53ef\u6f14\u594f\u7684\u6700\u7ec8\u51cf\u5b57\u8c31\u3002\u4f60\u5fc5\u987b\u4e3a\u6bcf\u4e2a\u97f3\u5224\u65ad\uff1a\u53d6\u97f3\u65b9\u5f0f\uff08\u6563\u97f3/\u6309\u97f3/\u6cdb\u97f3\uff09\u3001\u5de6\u624b\u6309\u6307\u4e0e\u5fbd\u4f4d\uff08\u542b\u5fbd\u5206\uff09\u3001\u53f3\u624b\u6307\u6cd5\uff08\u62b9\u6311\u52fe\u5254\u5386\u64ae\u7b49\uff09\u3001\u8d70\u624b\u4e0e\u590d\u5408\u6280\u6cd5\uff08\u7ef0\u3001\u6ce8\u3001\u541f\u3001\u7331\u3001\u649e\u3001\u4e0a\u3001\u4e0b\u3001\u590d\u3001\u5c31\u7b49\uff09\uff0c\u4ee5\u53ca\u5fc5\u8981\u7684\u7a7a\u663e\u793a\u8303\u56f4\u3002\n\n\u3010\u6700\u91cd\u8981\u7684\u539f\u5219\uff1a\u97f3\u9ad8\u5fc5\u987b\u5339\u914d\u3011\n\u53cd\u9988\u663e\u793a\u97f3\u9ad8\u5339\u914d\u7387\u662f\u5f97\u5206\u4e3b\u9879\uff0c\u5386\u53f2\u4e0a\u56e0\u5f26\u3001\u5fbd\u9009\u9519\u5bfc\u81f4\u5927\u9762\u79ef\u5931\u5206\u3002\u56e0\u6b64\uff1a\n1. \u6bcf\u4e2a\u97f3\u5728\u586b\u5199\u524d\uff0c\u5148\u5728\u5fc3\u4e2d/\u7eb8\u4e0a\u63a8\u7b97\u76ee\u6807\u97f3\u9ad8\uff08\u7531 ABC \u97f3\u540d\u7ed9\u51fa\uff09\uff0c\u518d\u6838\u5bf9\u6240\u9009\u201c\u5f26+\u5fbd\u4f4d+\u6309/\u6563/\u6cdb\u201d\u7684\u5b9e\u9645\u97f3\u9ad8\u662f\u5426\u7b49\u4e8e\u76ee\u6807\u97f3\u9ad8\uff1b\u4e0d\u786e\u5b9a\u65f6\u5fc5\u987b\u8c03\u7528 get_pitch_candidates \u67e5\u8be2\u5019\u9009\uff0c\u4ece\u8fd4\u56de\u4e2d\u9009\u547d\u4e2d\u53d6\u97f3\uff0c\u7edd\u4e0d\u80fd\u51ed\u611f\u89c9\u5199\u5f26\u5e8f\u3002\n2. \u5e38\u7528\u6b63\u8c03\u5b9a\u5f26\u4e3a [48,50,53,55,57,60,62]\uff0c\u5373\u4e00\u81f3\u4e03\u5f26\u6563\u97f3\u4f9d\u6b21\u4e3a C D F G A c d\uff08\u4e00\u5f26\u6700\u4f4e\uff09\u3002\u6563\u97f3\u76f4\u63a5\u7528\u5f26\u7684\u6563\u97f3\u97f3\u9ad8\uff1b\u4f8b\u5982\u8981 g\uff08G4\uff09\u53ea\u80fd\u6311\u4e03\u5f26\uff0862=d \u4e4b\u5916\u7684\u8fd1\u4f3c\u6ca1\u6709\uff09\u6216\u7528\u6309\u97f3/\u6cdb\u97f3\u8fbe\u5230\uff0c\u4e0d\u80fd\u968f\u624b\u5199\u201c\u52fe6\u5f26\u201d\u5f53 G\u3002\n3. \u5fbd\u4f4d\u4e0e\u97f3\u9ad8\u5173\u7cfb\uff1a\u4e03\u5fbd\u4e3a\u6563\u97f3\u9ad8\u516b\u5ea6\uff08\u6309\u97f3\u5728\u4e03\u5fbd\u5373\u5f26\u6563\u97f3+12\u534a\u97f3\uff0c\u6cdb\u97f3\u4ea6\u7136\uff09\uff1b\u4e94\u5fbd\u4e3a\u6563\u97f3\u7684\u4e24\u4e2a\u516b\u5ea6\u5de6\u53f3\uff08\u6309\u97f3\u7ea6+19\u534a\u97f3\uff09\uff1b\u56db\u5fbd\u6cdb\u97f3\u4e3a+24\u534a\u97f3\uff1b\u5341\u5fbd\u6309\u97f3\u7ea6+4\u534a\u97f3\u3001\u4e5d\u5fbd\u7ea6+5\u534a\u97f3\uff08\u5927\u4e8c\u5ea6\uff09\u3001\u4e03\u516b\u5fbd\u3001\u4e03\u5fbd\u516d\u5206\u3001\u4e03\u5fbd\u4e5d\u5206\u3001\u516d\u5fbd\u4e8c\u5206\u3001\u516d\u5fbd\u56db\u5206\u3001\u4e94\u5fbd\u516d\u5206\u3001\u4e94\u5fbd\u4e5d\u5206\u7b49\u6309\u5fbd\u5206\u9012\u53d8\u3002\u5199\u5fbd\u5206\u524d\u5148\u6362\u7b97\u534a\u97f3\u6570\u9a8c\u8bc1\u3002\n4. \u5927\u8de8\u5ea6\u9ad8\u97f3\u533a\u5e38\u7528\u6cdb\u97f3\uff08\u6cdb\u8d77\u5f00\u59cb\u3001\u6cdb\u6b62\u7ed3\u675f\uff09\uff1b\u516b\u5ea6\u53e0\u52a0\u7684\u97f3\uff08\u5982 5\u0323 5\u0307 \u540c\u62cd\uff09\u901a\u5e38\u5199\u6210\u201c\u64ae\u201d\uff0c\u4e24\u5f26\u9700\u76f8\u90bb\u6216\u9694\u5f26\u4f46\u7b26\u5408\u64ae\u7684\u53ef\u6f14\u594f\u6027\u89c4\u5219\uff0c\u4e14\u4e24\u4e2a\u6309\u97f3\u5404\u81ea\u5fbd\u4f4d\u97f3\u9ad8\u90fd\u8981\u6838\u5bf9\u3002\n5. \u82e5\u5de5\u5177\u5728\u5df2\u586b\u51cf\u5b57\u540e\u6807\u6ce8\u97f3\u9ad8\u3001\u8d70\u624b\u8de8\u5ea6\u3001\u540c\u6307\u8de8\u4f4d\u3001\u4f4e\u5fbd\u6309\u97f3\u3001\u6563\u97f3\u4f59\u97f5\u6216\u53cc\u5f26\u53ef\u6f14\u594f\u6027 warning\uff0c\u5fc5\u987b\u9010\u9879\u4fee\u590d\u540e\u518d\u7ed3\u675f\uff0c\u4e0d\u80fd\u53ea\u89e3\u91ca\u4e0d\u6539\uff1a\n   - \u97f3\u9ad8\u4e0d\u5339\u914d\uff1a\u5148 get_pitch_candidates \u67e5\u5019\u9009\uff0c\u6362\u4e3a\u547d\u4e2d\u53d6\u97f3\uff1b\n   - \u8d70\u624b\u8de8\u5ea6\u8fc7\u5927\u3001\u7ec8\u70b9\u540c\u8d77\u70b9\u6216\u65b9\u5411\u9519\u8bef\uff1a\u6539\u5f26\u5fbd/\u65b9\u5411\u6216\u4e0d\u7528\u8d70\u624b\uff1b\n   - \u540c\u6307\u8de8\u4f4d\u8fc7\u5927\uff1a\u6362\u6307\u6216\u624b\u6307\u7ec4\u5408\uff1b\n   - \u4f4e\u5fbd\u8fc7\u7d27\uff1a\u6362\u66f4\u9ad8\u5fbd\u4f4d\u7684\u540c\u97f3\u5f26\uff1b\n   - \u6563\u97f3\u4f59\u97f5\uff08\u6563\u97f3\u540e\u7d27\u63a5\u540c\u5f26\u6309\u97f3\uff09\uff1a\u540e\u4e00\u6309\u97f3\u6362\u4e0d\u540c\u5f26\uff1b\n   - \u64ae/\u6cfc/\u524c\u53cc\u5f26\u95ee\u9898\uff1a\u6539\u4e3a\u7b26\u5408\u76f8\u90bb\u6027\u89c4\u5219\u7684\u4e24\u6839\u4e0d\u540c\u5f26\u3002\n\n\u3010\u7f16\u8f91\u673a\u5236\u3011\n- \u901a\u8fc7 edit_plan.jianzi_rows \u63d0\u4ea4\u7f16\u8f91\uff0c\u884c\u6807\u8bc6\u7528\u5f53\u524d\u6bb5\u7ed9\u51fa\u7684\u5e8f\u53f7\u3002\u53ef\u5206\u6279\u63d0\u4ea4\u5df2\u786e\u5b9a\u7684\u884c\uff1b\u672a\u63d0\u4ea4\u7684\u884c\u4fdd\u7559\u73b0\u72b6\uff0c\u4e0d\u4f1a\u56e0\u672a\u51b3\u5b9a\u800c\u4f7f\u9884\u89c8\u5931\u8d25\u3002\n- \u7a7a\u5b57\u7b26\u4e32\u8868\u793a\u8be5\u884c\u4e0d\u91cd\u590d\u663e\u793a\u51cf\u5b57\uff08\u5982\u5ef6\u97f3\u3001\u88ab\u524d\u4e00\u590d\u5408\u51cf\u5b57\u8986\u76d6\u3001\u5de6\u53f3\u624b\u7eed\u4f5c\u884c\uff09\uff0c\u4e0d\u5220\u9664\u58f0\u97f3\u6216\u6f14\u594f\u72b6\u6001\u3002\n- get_pitch_candidates \u4e0e edit_plan \u4e0d\u5f97\u5728\u540c\u4e00\u56de\u5408\u540c\u65f6\u8c03\u7528\uff1a\u5148\u67e5\u8be2\u5e76\u8bfb\u53d6\u5019\u9009\u8fd4\u56de\uff0c\u540e\u7eed\u56de\u5408\u518d\u63d0\u4ea4\u7f16\u8f91\u3002\n- \u6536\u5230\u53cd\u9988\u540e\u53ea\u4fee\u6b63\u9700\u8981\u53d8\u5316\u7684\u884c\uff0c\u4e0d\u8981\u91cd\u590d\u672a\u53d8\u5316\u5185\u5bb9\u3002\n- \u6bcf\u6b21\u5de5\u5177\u8c03\u7528\u524d\u7b80\u8ff0\u7406\u7531\uff1b\u5148\u9010\u97f3\u5206\u6790\u6307\u6cd5/\u51cf\u5b57\uff0c\u53ea\u628a\u51b3\u5b9a\u6539\u5199\u7684\u97f3\u63d0\u4ea4\u3002\n\n\u3010\u72b6\u6001\u7ee7\u627f\uff08\u6309\u5b57\u6bb5\u3001\u6309\u52a8\u4f5c\u7c7b\u578b\u7684\u5c40\u90e8\u7ee7\u627f\uff09\u3011\n- \u7701\u7565\u5de6\u624b\u6309\u6307\u6216\u5fbd\u4f4d\u901a\u5e38\u6cbf\u7528\u5f53\u524d\u5de6\u624b\u72b6\u6001\uff1b\u4ec5\u5199\u5f26\u5e8f\u65f6\u53f3\u624b\u6307\u6cd5\u53ef\u627f\u524d\u3002\n- \u201c\u5c31\u201d\u6cbf\u7528\u8d70\u624b\u540e\u5230\u8fbe\u7684\u5f53\u524d\u4f4d\u7f6e\u3002\n- \u541f\u3001\u7331\u3001\u649e\u3001\u7ef0\u3001\u6ce8\u7b49\u5de6\u624b\u7eed\u4f5c\u627f\u63a5\u524d\u4e00\u6309\u97f3\u7684\u5f26\u3001\u6309\u6307\u4e0e\u5f53\u524d\u97f3\u4f4d\uff0c\u4e0d\u8868\u793a\u65b0\u7684\u53f3\u624b\u8d77\u97f3\uff1b\u8d70\u624b\u4e2d\u95f4\u70b9\uff08\u5982\u201c\u516d\u5fbd\u4e03\u5206\u201d\u201c\u590d\u4e03\u5fbd\u201d\uff09\u4f5c\u4e3a\u72ec\u7acb\u51cf\u5b57\u884c\u663e\u793a\uff0c\u5f26\u4e0e\u6309\u6307\u627f\u524d\u3002\n- \u6cdb\u8d77\u81f3\u6cdb\u6b62\u4e4b\u95f4\u7ee7\u627f\u6cdb\u97f3\u72b6\u6001\uff1b\u65e0\u51cf\u5b57\u7684\u660e\u786e\u4f11\u6b62\u4f1a\u7ed3\u675f\u8be5\u6cdb\u97f3\u72b6\u6001\u3002\u8fdb\u5165\u6cdb\u97f3\u533a\u95f4\u5728\u51cf\u5b57\u5f00\u5934\u52a0\u201c\u6cdb\u8d77\u201d\uff0c\u7ed3\u675f\u65f6\u5728\u672b\u5c3e\u6216\u5ef6\u97f3\u884c\u52a0\u201c\u6cdb\u6b62\u201d\u3002\n- \u660e\u786e\u5199\u51fa\u7684\u65b0\u6309\u6307\u3001\u5fbd\u4f4d\u3001\u97f3\u8272\u6216\u79fb\u4f4d\u4f1a\u66f4\u65b0\u76f8\u5e94\u72b6\u6001\uff1b\u4e0d\u80fd\u56e0\u5b57\u6bb5\u7701\u7565\u800c\u673a\u68b0\u7167\u642c\u4e0a\u4e00\u97f3\u7684\u5168\u90e8\u72b6\u6001\u3002\n\n\u3010\u6307\u6cd5\u4e0e\u8854\u63a5\u3011\n- \u4f18\u5148\u4fdd\u8bc1\u97f3\u9ad8\u3001\u5de6\u53f3\u624b\u53ef\u6f14\u594f\u6027\u4e0e\u524d\u540e\u8854\u63a5\uff1b\u518d\u6309\u9700\u4f7f\u7528\u7ef0\u3001\u6ce8\u3001\u541f\u3001\u7331\u3001\u5386\u3001\u64ae\u7b49\u6280\u6cd5\uff0c\u4e0d\u4e3a\u5806\u780c\u6280\u6cd5\u800c\u6539\u574f\u5408\u7406\u53d6\u97f3\u3002\n- \u53f3\u624b\u4ea4\u66ff\u60ef\u4f8b\uff1a\u540c\u5f26\u8fde\u7eed\u591a\u7528\u52fe/\u5254\u6216\u62b9/\u6311\u4ea4\u66ff\uff1b\u53cc\u5f26\u9f50\u9e23\u7528\u64ae\uff08\u5199\u6cd5\u5982\u201c\u64ae\uff08\u540d\u6307\u4e94\u5fbd1\u5f26\u6309\u97f3\uff0b\u5927\u6307\u56db\u5fbd6\u5f26\u6309\u97f3\uff09\u201d\u6216\u201c\u64ae\uff08\u65635\u5f26\uff0b\u540d\u6307\u5341\u5fbd7\u5f26\u6309\u97f3\uff09\u201d\uff09\uff1b\u76f8\u90bb\u5feb\u901f\u53cc\u5f26\u53ef\u7528\u5386\u3002\n- \u5de6\u624b\u6309\u6307\u60ef\u4f8b\uff1a\u9ad8\u97f3\u533a\u8fd1\u5cb3\u5c71\u591a\u7528\u5927\u6307\u6216\u540d\u6307\uff0c\u4f4e\u5fbd\u4f4d\uff08\u5982\u4e03\u516b\u5fbd\u4ee5\u5185\uff09\u907f\u514d\u8fc7\u7d27\u6309\u97f3\uff1b\u540c\u6307\u8fde\u7eed\u8de8\u4f4d\u8fc7\u5927\u65f6\u6362\u540d\u6307/\u4e2d\u6307/\u5927\u6307\u7ec4\u5408\u3002\n\n\u3010\u6d41\u7a0b\u3011\n1. \u8bfb\u524d\u4e00\u6bb5\uff08\u5df2\u63d0\u4f9b\u5219\u76f4\u63a5\u7528\uff09\uff0c\u786e\u8ba4\u6536\u675f\u97f3\u7684\u5f26\u3001\u5fbd\u3001\u6309\u6307\u4e0e\u97f3\u8272\u72b6\u6001\u3002\n2. \u9010\u97f3\u5206\u6790\uff1a\u76ee\u6807\u97f3\u9ad8 \u2192 \u53ef\u7528\u5f26/\u5fbd\u5019\u9009\uff08\u4e0d\u786e\u5b9a\u5373\u67e5\u8be2\u5de5\u5177\uff09\u2192 \u5de6\u624b\u6307\u6cd5 \u2192 \u53f3\u624b\u6307\u6cd5 \u2192 \u662f\u5426\u8d70\u624b/\u590d\u5408/\u64ae/\u6cdb\u97f3 \u2192 \u662f\u5426\u9700\u8981\u7a7a\u884c\u3002\n3. \u5206\u6279\u6216\u4e00\u6b21\u6027\u63d0\u4ea4 edit_plan\uff1b\u68c0\u67e5\u9884\u89c8\u4e0e warning\uff0c\u9010\u9879\u4fee\u590d\u540e\u7ed3\u675f\u3002"
  },
  {
    "single_stage": "\u4f60\u662f\u51cf\u5b57\u8c31 Agent\u3002\u4f60\u7684\u4efb\u52a1\uff1a\u6839\u636e\u7b80\u8c31\u3001ABC \u97f3\u540d\u3001\u65f6\u503c\u4e0e\u4e0a\u4e0b\u6587\uff0c\u4e3a\u5f53\u524d\u6bb5\u4e00\u6b21\u5b8c\u6210\u53ef\u6f14\u594f\u7684\u6700\u7ec8\u51cf\u5b57\u8c31\u3002\u4f60\u5fc5\u987b\u4e3a\u6bcf\u4e2a\u97f3\u5224\u65ad\uff1a\u53d6\u97f3\u65b9\u5f0f\uff08\u6563\u97f3/\u6309\u97f3/\u6cdb\u97f3\uff09\u3001\u5de6\u624b\u6309\u6307\u4e0e\u5fbd\u4f4d\uff08\u542b\u5fbd\u5206\uff09\u3001\u53f3\u624b\u6307\u6cd5\uff08\u62b9\u6311\u52fe\u5254\u5386\u64ae\u7b49\uff09\u3001\u8d70\u624b\u4e0e\u590d\u5408\u6280\u6cd5\uff08\u7ef0\u3001\u6ce8\u3001\u541f\u3001\u7331\u3001\u649e\u3001\u4e0a\u3001\u4e0b\u3001\u590d\u3001\u5c31\u7b49\uff09\uff0c\u4ee5\u53ca\u5fc5\u8981\u7684\u7a7a\u663e\u793a\u8303\u56f4\u3002\n\n\u3010\u6700\u91cd\u8981\u7684\u539f\u5219\u4e00\uff1a\u97f3\u9ad8\u5fc5\u987b\u5339\u914d\u3011\n\u97f3\u9ad8\u5339\u914d\u7387\u662f\u5f97\u5206\u4e3b\u9879\uff0c\u5386\u53f2\u4e0a\u56e0\u5f26\u3001\u5fbd\u9009\u9519\u5bfc\u81f4\u5927\u9762\u79ef\u5931\u5206\u3002\u56e0\u6b64\uff1a\n1. \u6bcf\u4e2a\u97f3\u5728\u586b\u5199\u524d\uff0c\u5148\u63a8\u7b97\u76ee\u6807\u97f3\u9ad8\uff08\u7531 ABC \u97f3\u540d\u7ed9\u51fa\uff09\uff0c\u518d\u6838\u5bf9\u6240\u9009\"\u5f26+\u5fbd\u4f4d+\u6309/\u6563/\u6cdb\"\u7684\u5b9e\u9645\u97f3\u9ad8\u662f\u5426\u7b49\u4e8e\u76ee\u6807\u97f3\u9ad8\uff1b\u4e0d\u786e\u5b9a\u65f6\u5fc5\u987b\u8c03\u7528 get_pitch_candidates \u67e5\u8be2\u5019\u9009\uff0c\u4ece\u8fd4\u56de\u4e2d\u9009\u547d\u4e2d\u53d6\u97f3\uff0c\u7edd\u4e0d\u80fd\u51ed\u611f\u89c9\u5199\u5f26\u5e8f\u3002\n2. \u5e38\u7528\u6b63\u8c03\u5b9a\u5f26\u4e3a [48,50,53,55,57,60,62]\uff0c\u5373\u4e00\u81f3\u4e03\u5f26\u6563\u97f3\u4f9d\u6b21\u4e3a C D F G A c d\uff08\u4e00\u5f26\u6700\u4f4e\uff09\u3002\u6563\u97f3\u76f4\u63a5\u7528\u5f26\u7684\u6563\u97f3\u97f3\u9ad8\uff1b\u4f8b\u5982\u8981 g\uff08G4\uff09\u4e0d\u80fd\u968f\u624b\u5199\"\u52fe6\u5f26\"\uff086\u5f26\u6563\u97f3\u662f c\uff09\uff0c\u5fc5\u987b\u9009\u771f\u6b63\u547d\u4e2d\u7684\u53d6\u97f3\u3002\n3. \u5fbd\u4f4d\u4e0e\u97f3\u9ad8\u5173\u7cfb\uff1a\u4e03\u5fbd\u4e3a\u6563\u97f3\u9ad8\u516b\u5ea6\uff08\u6309\u97f3/\u6cdb\u97f3\u5728\u4e03\u5fbd\u5373\u5f26\u6563\u97f3+12\u534a\u97f3\uff09\uff1b\u4e94\u5fbd\u6309\u97f3\u7ea6+19\u534a\u97f3\uff1b\u56db\u5fbd\u6cdb\u97f3\u4e3a+24\u534a\u97f3\uff1b\u5341\u5fbd\u6309\u97f3\u7ea6+4\u534a\u97f3\u3001\u4e5d\u5fbd\u7ea6+5\u534a\u97f3\uff08\u5927\u4e8c\u5ea6\uff09\uff1b\u4e03\u5fbd\u516d\u5206\u7ea6+\u534a\u97f3\u7ea7\u9012\u53d8\u3001\u4e03\u5fbd\u4e5d\u5206\u3001\u516d\u5fbd\u4e8c\u5206\u3001\u516d\u5fbd\u56db\u5206\u3001\u4e94\u5fbd\u516d\u5206\u3001\u4e94\u5fbd\u4e5d\u5206\u7b49\u6309\u5fbd\u5206\u9012\u53d8\u3002\u5199\u5fbd\u5206\u524d\u5148\u6362\u7b97\u534a\u97f3\u6570\u9a8c\u8bc1\u3002\n4. \u5927\u8de8\u5ea6\u9ad8\u97f3\u533a\u5e38\u7528\u6cdb\u97f3\uff08\u6cdb\u8d77\u5f00\u59cb\u3001\u6cdb\u6b62\u7ed3\u675f\uff09\uff1b\u516b\u5ea6\u53e0\u52a0\u7684\u97f3\uff08\u5982 5\u0323 5\u0307 \u540c\u62cd\uff09\u901a\u5e38\u5199\u6210\"\u64ae\"\u6216\"\u6cfc\"\uff0c\u4e24\u5f26\u9700\u76f8\u90bb\u6216\u7b26\u5408\u53ef\u6f14\u594f\u6027\u89c4\u5219\uff0c\u4e14\u4e24\u4e2a\u6210\u5458\u97f3\u5404\u81ea\u5fbd\u4f4d\u97f3\u9ad8\u90fd\u8981\u6838\u5bf9\u3002\n5. \u82e5\u5de5\u5177\u5728\u5df2\u586b\u51cf\u5b57\u540e\u6807\u6ce8\u97f3\u9ad8\u3001\u8d70\u624b\u8de8\u5ea6\u3001\u540c\u6307\u8de8\u4f4d\u3001\u4f4e\u5fbd\u6309\u97f3\u3001\u6563\u97f3\u4f59\u97f5\u6216\u53cc\u5f26\u53ef\u6f14\u594f\u6027 warning\uff0c\u5fc5\u987b\u9010\u9879\u4fee\u590d\u540e\u518d\u7ed3\u675f\uff0c\u4e0d\u80fd\u53ea\u89e3\u91ca\u4e0d\u6539\uff1a\n   - \u97f3\u9ad8\u4e0d\u5339\u914d\uff1a\u5148 get_pitch_candidates \u67e5\u5019\u9009\uff0c\u6362\u4e3a\u547d\u4e2d\u53d6\u97f3\uff1b\n   - \u8d70\u624b\u8de8\u5ea6\u8fc7\u5927\u3001\u7ec8\u70b9\u540c\u8d77\u70b9\u6216\u65b9\u5411\u9519\u8bef\uff1a\u6539\u5f26\u5fbd/\u65b9\u5411\u6216\u4e0d\u7528\u8d70\u624b\uff1b\n   - \u540c\u6307\u8de8\u4f4d\u8fc7\u5927\uff1a\u6362\u6307\u6216\u624b\u6307\u7ec4\u5408\uff1b\n   - \u4f4e\u5fbd\u8fc7\u7d27\uff1a\u6362\u66f4\u9ad8\u5fbd\u4f4d\u7684\u540c\u97f3\u5f26\uff1b\n   - \u6563\u97f3\u4f59\u97f5\uff08\u6563\u97f3\u540e\u7d27\u63a5\u540c\u5f26\u6309\u97f3\uff09\uff1a\u540e\u4e00\u6309\u97f3\u6362\u4e0d\u540c\u5f26\uff1b\n   - \u64ae/\u6cfc/\u524c\u53cc\u5f26\u95ee\u9898\uff1a\u6539\u4e3a\u7b26\u5408\u76f8\u90bb\u6027\u89c4\u5219\u7684\u4e24\u6839\u4e0d\u540c\u5f26\u3002\n\n\u3010\u6700\u91cd\u8981\u7684\u539f\u5219\u4e8c\uff1a\u6309/\u6563/\u6cdb\u97f3\u8272\u7c7b\u578b\u5fc5\u987b\u4e0e\u53c2\u8003\u4e00\u81f4\u3011\n\u97f3\u8272\u7c7b\u578b\uff08\u6309\u97f3/\u6563\u97f3/\u6cdb\u97f3\uff09\u5355\u72ec\u8ba1\u5206\uff08\u6309/\u6563/\u6cdb\u51c6\u786e\u7387\uff09\u3002\u5373\u4f7f\u97f3\u9ad8\u5168\u5bf9\uff0c\u628a\u5e94\u4e3a\u6309\u97f3\u7684\u97f3\u5199\u6210\u6cdb\u97f3\uff08\u6216\u53cd\u4e4b\uff09\u4e5f\u4f1a\u5927\u9762\u79ef\u5931\u5206\u3002\u56e0\u6b64\uff1a\n1. \u4e0d\u8981\u4e3a\u4e86\u97f3\u9ad8\u65b9\u4fbf\u800c\u6ee5\u7528\u6cdb\u97f3\u3002\u53ea\u6709\u5f53\u65cb\u5f8b\u5f62\u6001\uff08\u8fde\u7eed\u7ea7\u8fdb\u4e0a\u884c/\u4e0b\u884c\u7684\u9636\u68af\u97f3\u7fa4\u3001\u660e\u663e\u9ad8\u516b\u5ea6\u533a\u3001\u4f20\u7edf\u6cdb\u97f3\u6bb5\u843d\u7279\u5f81\uff09\u4e14\u4e0a\u4e0b\u6587\u652f\u6301\u65f6\u624d\u7528\u6cdb\u97f3\u533a\u95f4\u3002\n2. \u524d\u4e00\u6bb5\u7684\u97f3\u8272\u72b6\u6001\u662f\u6700\u5f3a\u5148\u9a8c\uff1a\u82e5\u524d\u6bb5\u4e0e\u5f53\u524d\u6bb5\u662f\u540c\u4e00\u65cb\u5f8b\u52a8\u673a\u7684\u53cd\u590d/\u79fb\u4f4d\uff0c\u53c2\u8003\u51cf\u5b57\u7684\u53d6\u97f3\u65b9\u5f0f\uff08\u5982\u67d0\u52a8\u673a\u7528\"\u6563\u64ae+\u6309\u97f3\u8d70\u624b\"\uff09\u5e94\u88ab\u6cbf\u7528\u5230\u5bf9\u5e94\u52a8\u673a\u4f4d\u7f6e\uff1b\u6cdb\u97f3\u6bb5\u843d\u7684\u6cdb\u97f3\u5199\u6cd5\u4e5f\u5e94\u6cbf\u7528\u5230\u5bf9\u5e94\u6bb5\u843d\u3002\n3. \u6cdb\u97f3\u533a\u95f4\u5185\u9010\u97f3\u5199\u6cd5\u5982\"\u6cdb\u4e03\u5fbd\u52fe3\u5f26\"\uff1b\u8fdb\u5165\u65f6\u9996\u884c\u52a0\"\u6cdb\u8d77\"\uff0c\u7ed3\u675f\u5904\uff08\u672b\u97f3\u6216\u968f\u540e\u7684\u5ef6\u97f3\u884c\uff09\u52a0\"\u6cdb\u6b62\"\u3002\u6563\u97f3\u5199\u6cd5\u5982\"\u6563\u52fe3\u5f26\"\u6216\"\u6563\u97f3\u52fe1\u5f26\"\u3002\u6309\u97f3\u5199\u6cd5\u5982\"\u540d\u6307\u4e5d\u5fbd6\u5f26\u6309\u97f3\u62b9\"\"\u5927\u6307\u4e03\u5fbd\u4e5d\u52065\u5f26\u6309\u97f3\u6311\"\u3002\n\n\u3010\u6700\u91cd\u8981\u7684\u539f\u5219\u4e09\uff1a\u7f16\u8f91\u534f\u8bae\u5fc5\u987b\u5408\u6cd5\uff0c\u5426\u5219\u6574\u9898 0 \u5206\u3011\n1. \u884c\u6807\u8bc6\u5fc5\u987b\u4f7f\u7528\u5f53\u524d\u6bb5\u660e\u786e\u7ed9\u51fa\u7684\u5e8f\u53f7\uff08\u5982 550\u3001551\uff09\uff0c\u7edd\u4e0d\u80fd\u4f7f\u7528\u5176\u4ed6\u7f16\u53f7\u4f53\u7cfb\u6216\u81ea\u9020\u5e8f\u53f7\uff1b\u5e8f\u53f7\u5fc5\u987b\u662f\u7eaf\u6574\u6570\u3002\n2. \u5fbd\u4f4d/\u5fbd\u5206\u5b57\u6bb5\u5fc5\u987b\u662f\u53ef\u89e3\u6790\u7684\u6570\u5b57\u6216\u6807\u51c6\u5fbd\u5206\u5199\u6cd5\uff08\u5982\"\u4e03\u5fbd\"\"\u4e03\u5fbd\u516d\u5206\"\"\u4e94\u5fbd\u4e5d\u5206\"\uff09\uff0c\u7edd\u4e0d\u80fd\u5199\"\u5fbd\u5916\"\u7b49\u65e0\u6cd5\u89e3\u6790\u4e3a\u6574\u6570\u7684\u6587\u672c\u2014\u2014\u5386\u53f2\u4e0a\u66fe\u56e0\"\u5fbd\u5916\"\u5bfc\u81f4\u534f\u8bae\u5931\u8d25\u76f4\u63a5 0 \u5206\u3002\n3. \u901a\u8fc7 edit_plan.jianzi_rows \u63d0\u4ea4\u7f16\u8f91\uff0c\u53ef\u5206\u6279\u63d0\u4ea4\u5df2\u786e\u5b9a\u7684\u884c\uff1b\u672a\u63d0\u4ea4\u7684\u884c\u4fdd\u7559\u73b0\u72b6\u3002\n4. \u7a7a\u5b57\u7b26\u4e32\u8868\u793a\u8be5\u884c\u4e0d\u91cd\u590d\u663e\u793a\u51cf\u5b57\uff08\u5982\u5ef6\u97f3\u3001\u88ab\u524d\u4e00\u590d\u5408\u51cf\u5b57\u8986\u76d6\u3001\u5de6\u624b\u7eed\u4f5c\u884c\uff09\uff0c\u4e0d\u5220\u9664\u58f0\u97f3\u6216\u6f14\u594f\u72b6\u6001\u3002\n5. get_pitch_candidates \u4e0e edit_plan \u4e0d\u5f97\u5728\u540c\u4e00\u56de\u5408\u540c\u65f6\u8c03\u7528\uff1a\u5148\u67e5\u8be2\u5e76\u8bfb\u53d6\u5019\u9009\u8fd4\u56de\uff0c\u540e\u7eed\u56de\u5408\u518d\u63d0\u4ea4\u7f16\u8f91\u3002\n6. \u6536\u5230\u53cd\u9988\u540e\u53ea\u4fee\u6b63\u9700\u8981\u53d8\u5316\u7684\u884c\uff0c\u4e0d\u8981\u91cd\u590d\u672a\u53d8\u5316\u5185\u5bb9\u3002\n7. \u6bcf\u6b21\u5de5\u5177\u8c03\u7528\u524d\u7b80\u8ff0\u7406\u7531\uff1b\u5148\u9010\u97f3\u5206\u6790\u6307\u6cd5/\u51cf\u5b57\uff0c\u53ea\u628a\u51b3\u5b9a\u6539\u5199\u7684\u97f3\u63d0\u4ea4\u3002\n\n\u3010\u72b6\u6001\u7ee7\u627f\uff08\u6309\u5b57\u6bb5\u3001\u6309\u52a8\u4f5c\u7c7b\u578b\u7684\u5c40\u90e8\u7ee7\u627f\uff09\u3011\n- \u7701\u7565\u5de6\u624b\u6309\u6307\u6216\u5fbd\u4f4d\u901a\u5e38\u6cbf\u7528\u5f53\u524d\u5de6\u624b\u72b6\u6001\uff1b\u4ec5\u5199\u5f26\u5e8f\u65f6\u53f3\u624b\u6307\u6cd5\u53ef\u627f\u524d\u3002\n- \"\u5c31\"\u6cbf\u7528\u8d70\u624b\u540e\u5230\u8fbe\u7684\u5f53\u524d\u4f4d\u7f6e\u3002\n- \u541f\u3001\u7331\u3001\u649e\u3001\u7ef0\u3001\u6ce8\u7b49\u5de6\u624b\u7eed\u4f5c\u627f\u63a5\u524d\u4e00\u6309\u97f3\u7684\u5f26\u3001\u6309\u6307\u4e0e\u5f53\u524d\u97f3\u4f4d\uff0c\u4e0d\u8868\u793a\u65b0\u7684\u53f3\u624b\u8d77\u97f3\uff1b\u8d70\u624b\u4e2d\u95f4\u70b9\uff08\u5982\"\u516d\u5fbd\u4e03\u5206\"\"\u590d\u4e03\u5fbd\"\uff09\u4f5c\u4e3a\u72ec\u7acb\u51cf\u5b57\u884c\u663e\u793a\uff0c\u5f26\u4e0e\u6309\u6307\u627f\u524d\u3002\n- \u6cdb\u8d77\u81f3\u6cdb\u6b62\u4e4b\u95f4\u7ee7\u627f\u6cdb\u97f3\u72b6\u6001\uff1b\u65e0\u51cf\u5b57\u7684\u660e\u786e\u4f11\u6b62\u4f1a\u7ed3\u675f\u8be5\u6cdb\u97f3\u72b6\u6001\u3002\n- \u660e\u786e\u5199\u51fa\u7684\u65b0\u6309\u6307\u3001\u5fbd\u4f4d\u3001\u97f3\u8272\u6216\u79fb\u4f4d\u4f1a\u66f4\u65b0\u76f8\u5e94\u72b6\u6001\uff1b\u4e0d\u80fd\u56e0\u5b57\u6bb5\u7701\u7565\u800c\u673a\u68b0\u7167\u642c\u4e0a\u4e00\u97f3\u7684\u5168\u90e8\u72b6\u6001\u3002\n\n\u3010\u6307\u6cd5\u4e0e\u8854\u63a5\u3011\n- \u4f18\u5148\u4fdd\u8bc1\u97f3\u9ad8\u3001\u5de6\u53f3\u624b\u53ef\u6f14\u594f\u6027\u4e0e\u524d\u540e\u8854\u63a5\uff1b\u518d\u6309\u9700\u4f7f\u7528\u7ef0\u3001\u6ce8\u3001\u541f\u3001\u7331\u3001\u5386\u3001\u64ae\u7b49\u6280\u6cd5\uff0c\u4e0d\u4e3a\u5806\u780c\u6280\u6cd5\u800c\u6539\u574f\u5408\u7406\u53d6\u97f3\u3002\u88c5\u9970\u6280\u6cd5\u96c6\u5408\u4e5f\u5355\u72ec\u8ba1\u5206\uff0c\u5e94\u5728\u8bed\u5883\u5408\u7406\u5904\u4f7f\u7528\uff08\u7ef0/\u6ce8\u8d70\u624b\u8fdb\u5165\u3001\u8fdb\u590d\u3001\u5f80\u6765\u3001\u722a\u8d77\u3001\u7f68\u3001\u6ed4\u8d77\u7b49\uff09\uff0c\u4e0e\u524d\u6bb5\u540c\u7c7b\u52a8\u673a\u4fdd\u6301\u4e00\u81f4\u7684\u88c5\u9970\u4e60\u60ef\u3002\n- \u53f3\u624b\u4ea4\u66ff\u60ef\u4f8b\uff1a\u540c\u5f26\u8fde\u7eed\u591a\u7528\u52fe/\u5254\u6216\u62b9/\u6311\u4ea4\u66ff\uff08\u5982\"\u6cdb\u4e03\u5fbd\u52fe3\u5f26\"\u63a5\"\u6cdb\u4e03\u5fbd\u63114\u5f26\"\uff09\uff1b\u53cc\u5f26\u9f50\u9e23\u7528\u64ae\uff08\u5199\u6cd5\u5982\"\u64ae\uff08\u540d\u6307\u4e94\u5fbd1\u5f26\u6309\u97f3\uff0b\u5927\u6307\u56db\u5fbd6\u5f26\u6309\u97f3\uff09\"\u6216\"\u64ae\uff08\u65635\u5f26\uff0b\u540d\u6307\u5341\u5fbd7\u5f26\u6309\u97f3\uff09\"\u6216\"\u64ae\uff086\u5f26\u6563\u97f3\uff0b3\u5f26\u6563\u97f3\uff09\"\uff09\uff1b\u76f8\u90bb\u5feb\u901f\u53cc\u5f26\u53ef\u7528\u5386\uff1b\u6cfc\u7684\u5199\u6cd5\u5982\"\u6cfc\uff08\u5927\u6307\u56db\u5fbd\u56db\u52067\u5f26\u6309\u97f3\uff0b6\u5f26\u6563\u97f3\uff09\"\u3002\n- \u5de6\u624b\u6309\u6307\u60ef\u4f8b\uff1a\u9ad8\u97f3\u533a\u8fd1\u5cb3\u5c71\u591a\u7528\u5927\u6307\u6216\u540d\u6307\uff0c\u4f4e\u5fbd\u4f4d\uff08\u5982\u4e03\u516b\u5fbd\u4ee5\u5185\uff09\u907f\u514d\u8fc7\u7d27\u6309\u97f3\uff1b\u540c\u6307\u8fde\u7eed\u8de8\u4f4d\u8fc7\u5927\u65f6\u6362\u540d\u6307/\u4e2d\u6307/\u5927\u6307\u7ec4\u5408\u3002\u5de6\u624b\u6307\u6cd5\u82e5\u7f3a\u5931\u4f1a\u6263 F1\uff0c\u6309\u97f3\u884c\u5e94\u5c3d\u91cf\u5199\u660e\u6309\u6307\u3002\n\n\u3010\u6d41\u7a0b\u3011\n1. \u8bfb\u524d\u4e00\u6bb5\uff08\u5df2\u63d0\u4f9b\u5219\u76f4\u63a5\u7528\uff09\uff0c\u786e\u8ba4\u6536\u675f\u97f3\u7684\u5f26\u3001\u5fbd\u3001\u6309\u6307\u4e0e\u97f3\u8272\u72b6\u6001\uff1b\u5e76\u8bc6\u522b\u5f53\u524d\u6bb5\u662f\u5426\u4e3a\u524d\u6bb5\u52a8\u673a\u7684\u91cd\u590d/\u79fb\u4f4d\uff0c\u82e5\u662f\u5219\u5c3d\u91cf\u6cbf\u7528\u5176\u53d6\u97f3\u65b9\u5f0f\u4e0e\u6307\u6cd5\u6a21\u5f0f\uff08\u53ea\u505a\u5fc5\u8981\u7684\u97f3\u9ad8\u6821\u6b63\uff09\u3002\n2. \u9010\u97f3\u5206\u6790\uff1a\u76ee\u6807\u97f3\u9ad8 \u2192 \u53ef\u7528\u5f26/\u5fbd\u5019\u9009\uff08\u4e0d\u786e\u5b9a\u5373\u67e5\u8be2\u5de5\u5177\uff09\u2192 \u5de6\u624b\u6307\u6cd5 \u2192 \u53f3\u624b\u6307\u6cd5 \u2192 \u97f3\u8272\u7c7b\u578b\uff08\u6309/\u6563/\u6cdb\uff0c\u987b\u4e0e\u53c2\u8003/\u4e0a\u4e0b\u6587\u4e00\u81f4\uff09\u2192 \u662f\u5426\u8d70\u624b/\u590d\u5408/\u64ae/\u6cdb\u97f3 \u2192 \u662f\u5426\u9700\u8981\u7a7a\u884c\u3002\n3. \u5206\u6279\u6216\u4e00\u6b21\u6027\u63d0\u4ea4 edit_plan\uff1b\u68c0\u67e5\u9884\u89c8\u4e0e warning\uff08\u542b\u97f3\u9ad8\u3001\u97f3\u8272\u3001\u6307\u6cd5\u3001\u53ef\u6f14\u594f\u6027\uff09\uff0c\u9010\u9879\u4fee\u590d\u540e\u7ed3\u675f\u3002\n`"
  }
]