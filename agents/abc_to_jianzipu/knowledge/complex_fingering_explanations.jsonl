{"index": 44, "category": "一般性指法/谱字符号", "name": "泛止", "explanation": "泛音结束的符号。"}
{"index": 53, "category": "右手指法", "name": "擘托", "explanation": "先擘后托。"}
{"index": 54, "category": "右手指法", "name": "抹挑", "explanation": "先抹后挑。"}
{"index": 55, "category": "右手指法", "name": "勾剔", "explanation": "先勾后剔。"}
{"index": 56, "category": "右手指法", "name": "打摘", "explanation": "先打后摘。"}
{"index": 57, "category": "右手指法", "name": "抹勾", "explanation": "先抹后勾。"}
{"index": 58, "category": "右手指法", "name": "叠涓", "explanation": "在同一弦上用食、中两指先抹后勾，急连相逐得音。"}
{"index": 60, "category": "右手指法", "name": "反涓", "explanation": "先剔后挑，或先打后勾，一重一轻，急奏二声。"}
{"index": 61, "category": "右手指法", "name": "半涓", "explanation": "在同弦上先抹后轻勾，后音略有声，与叠涓稍有区别。"}
{"index": 62, "category": "右手指法", "name": "连涓", "explanation": "同弦上先剔后勾，两声急连。"}
{"index": 63, "category": "右手指法", "name": "背锁", "explanation": "同弦上用剔、抹、挑急作三声。"}
{"index": 64, "category": "右手指法", "name": "短锁", "explanation": "同弦上先作抹、勾，再作剔、抹、挑，共五声。"}
{"index": 65, "category": "右手指法", "name": "长锁", "explanation": "同弦上先作若干抹、挑或抹、勾组合，再接锁法；常得七声，也可扩展为更多声。"}
{"index": 66, "category": "右手指法", "name": "轮", "explanation": "同弦上名、中、食三指次第急连触弦，得三声。"}
{"index": 67, "category": "右手指法", "name": "半轮", "explanation": "同弦上名、中二指次第急连触弦，得二声。"}
{"index": 68, "category": "右手指法", "name": "倒轮", "explanation": "同弦上食、中、名三指次第急连入弦，得三声。"}
{"index": 69, "category": "右手指法", "name": "倒轮换指三声", "explanation": "右手滚奏倒轮的同时，左手食、中、名三指在同一徽位上同时换指以作配合。"}
{"index": 70, "category": "右手指法", "name": "如一", "explanation": "两弦一按一散：一根弦用按音，另一根弦用散音；将按音徽位调至与散弦同音高，右手同时剔两弦，如同一声。"}
{"index": 71, "category": "右手指法", "name": "弹", "explanation": "弹（单次如一），两弦相连，一按一散，按内散外，以食指挑出，作如一之声。"}
{"index": 72, "category": "右手指法", "name": "双弹", "explanation": "两弦一按一散，中、食二指次第弹出，作两个如一之声。"}
{"index": 73, "category": "右手指法", "name": "三弹", "explanation": "两弦一按一散，用名、中、食三指次第弹出，作三个如一之声。"}
{"index": 74, "category": "右手指法", "name": "全扶", "explanation": "右手食指先连抹相邻两弦，然后中指再连勾此两弦。"}
{"index": 75, "category": "右手指法", "name": "半扶", "explanation": "食指连抹相邻两弦，然后用中指顺势止住第一弦的余音。"}
{"index": 76, "category": "右手指法", "name": "圆搂", "explanation": "用食、中两指同时抹、勾双弦。"}
{"index": 77, "category": "右手指法", "name": "拨", "explanation": "食、中、名三指同时在双弦上斜向内拨奏。"}
{"index": 78, "category": "右手指法", "name": "剌", "explanation": "食、中、名三指同时在双弦上向外斜向弹出。"}
{"index": 79, "category": "右手指法", "name": "拨剌", "explanation": "拨、剌两指法连用。"}
{"index": 80, "category": "右手指法", "name": "摘拨剌", "explanation": "名指先摘双弦如一声，随后立即接拨剌。"}
{"index": 81, "category": "右手指法", "name": "伏", "explanation": "食、中、名三指在一、二弦上向外剌出，同时伸直手指伏于弦上，遏住余音。"}
{"index": 82, "category": "右手指法", "name": "无声", "explanation": "无声；同“伏”。食、中、名三指在一、二弦上向外剌出，同时伸直手指伏于弦上，遏住余音。"}
{"index": 83, "category": "右手指法", "name": "拍杀", "explanation": "先奏拨剌，再接以伏。"}
{"index": 84, "category": "右手指法", "name": "截剌", "explanation": "同拍杀。"}
{"index": 85, "category": "右手指法", "name": "折竹声", "explanation": "同拍杀。"}
{"index": 86, "category": "右手指法", "name": "搓", "explanation": "中指、食指在同一弦上接连快速弹奏，合如一声。"}
{"index": 87, "category": "右手指法", "name": "鼓", "explanation": "即重双弹。"}
{"index": 88, "category": "右手指法", "name": "撮", "explanation": "食、中两指挑勾并作，同得一声。"}
{"index": 89, "category": "右手指法", "name": "大撮", "explanation": "大、中两指托勾并作，同得一声。"}
{"index": 90, "category": "右手指法", "name": "反撮", "explanation": "与撮相反，以反向指法并作而得一声。"}
{"index": 91, "category": "右手指法", "name": "扫", "explanation": "左手按一、二弦，右手食、中、名三指带相邻空弦剌出，得一声。"}
{"index": 92, "category": "右手指法", "name": "仰托", "explanation": "大指仰卧挑弦，得一煞声。"}
{"index": 93, "category": "右手指法", "name": "捻", "explanation": "大、食两指捻弦，提起而放，使弦击琴面而得一煞声。"}
{"index": 94, "category": "右手指法", "name": "打圆", "explanation": "食、中两指在两根弦上次第弹奏，循环往复得数声。"}
{"index": 95, "category": "右手指法", "name": "历", "explanation": "食指连挑，越过数弦。"}
{"index": 96, "category": "右手指法", "name": "渡", "explanation": "与历相似，但稍缓。"}
{"index": 97, "category": "右手指法", "name": "临", "explanation": "食指自七弦连挑至二弦，如历法；专用于泛音。"}
{"index": 98, "category": "右手指法", "name": "雷", "explanation": "食指连挑或名指连摘，如滚状，但音较缓，须逐声弹出，如雷之殷殷。"}
{"index": 99, "category": "右手指法", "name": "滚", "explanation": "名指连续摘相邻数弦。"}
{"index": 100, "category": "右手指法", "name": "拂", "explanation": "食指连续抹相邻数弦。"}
{"index": 101, "category": "右手指法", "name": "滚拂", "explanation": "先滚后拂，二法连用。"}
{"index": 102, "category": "右手指法", "name": "转圆", "explanation": "滚拂连用，循环不停。"}
{"index": 103, "category": "右手指法", "name": "掐撮", "explanation": "左手名指按弦，大指在上一音位掐起，右手随即撮一声。"}
{"index": 104, "category": "右手指法", "name": "掐撮三声", "explanation": "左手名指按弦；大指位于上一音位并作罨，掐起后右手随撮一声；随后大指再罨并连续掐起两次，先正后反；最后右手再撮一声，共八声。"}
{"index": 105, "category": "右手指法", "name": "掐撮剌三声", "explanation": "除将撮改为拨剌外，其余与掐撮三声相同。"}
{"index": 106, "category": "右手指法", "name": "小间勾", "explanation": "小间勾；隔一弦勾挑。"}
{"index": 107, "category": "右手指法", "name": "大间勾", "explanation": "大间勾；隔二弦勾挑。"}
{"index": 108, "category": "右手指法", "name": "牵", "explanation": "同勾而较重。"}
{"index": 113, "category": "左手指法", "name": "跪", "explanation": "名指屈中节，跪末节按弦。"}
{"index": 114, "category": "左手指法", "name": "绰", "explanation": "上滑音。"}
{"index": 115, "category": "左手指法", "name": "注", "explanation": "下滑音。"}
{"index": 116, "category": "左手指法", "name": "吟", "explanation": "幅度较小的揉弦。"}
{"index": 117, "category": "左手指法", "name": "长吟", "explanation": "时值较长的小幅度揉弦。"}
{"index": 118, "category": "左手指法", "name": "定吟", "explanation": "不移位的揉弦。"}
{"index": 119, "category": "左手指法", "name": "绰吟", "explanation": "先绰后吟。"}
{"index": 120, "category": "左手指法", "name": "注吟", "explanation": "先注后吟。"}
{"index": 121, "category": "左手指法", "name": "细吟", "explanation": "幅度小、速度快的揉弦。"}
{"index": 122, "category": "左手指法", "name": "游吟", "explanation": "带有小幅度进复的慢揉弦。"}
{"index": 123, "category": "左手指法", "name": "荡吟", "explanation": "同游吟，但在进复中音头加重。"}
{"index": 124, "category": "左手指法", "name": "急吟", "explanation": "急速的揉弦。"}
{"index": 125, "category": "左手指法", "name": "缓吟", "explanation": "缓慢的揉弦。"}
{"index": 126, "category": "左手指法", "name": "少吟", "explanation": "于音中稍作揉弦。"}
{"index": 127, "category": "左手指法", "name": "略吟", "explanation": "于音中略作揉弦。"}
{"index": 128, "category": "左手指法", "name": "缓急吟", "explanation": "同音高的连续两音，分先缓后急两次揉弦。"}
{"index": 129, "category": "左手指法", "name": "双吟", "explanation": "同音高的先后两音，俱用揉弦。"}
{"index": 130, "category": "左手指法", "name": "落指吟", "explanation": "得音即揉弦，不留空隙。"}
{"index": 131, "category": "左手指法", "name": "飞吟", "explanation": "得音后，上向揉弦与下向揉弦交替进行。"}
{"index": 132, "category": "左手指法", "name": "猱", "explanation": "得音后，左手作移动幅度较大的揉弦。"}
{"index": 133, "category": "左手指法", "name": "长猱", "explanation": "时值较长的大幅度揉弦。"}
{"index": 134, "category": "左手指法", "name": "绰猱", "explanation": "先绰后猱。"}
{"index": 135, "category": "左手指法", "name": "荡猱", "explanation": "与荡吟相似，但幅度较大。"}
{"index": 136, "category": "左手指法", "name": "略猱", "explanation": "似略吟而幅度稍大。"}
{"index": 137, "category": "左手指法", "name": "落指猱", "explanation": "得音即作幅度较大的揉弦。"}
{"index": 138, "category": "左手指法", "name": "缓猱", "explanation": "缓慢的大幅度揉弦。"}
{"index": 139, "category": "左手指法", "name": "急猱", "explanation": "快速而幅度较大的揉弦。"}
{"index": 140, "category": "左手指法", "name": "注猱", "explanation": "先注后猱。"}
{"index": 141, "category": "左手指法", "name": "撞猱", "explanation": "双撞加猱。"}
{"index": 142, "category": "左手指法", "name": "迎猱", "explanation": "连贯而柔缓的揉弦。"}
{"index": 143, "category": "左手指法", "name": "撞", "explanation": "左手得声后绰上稍许，然后立即回归本位。"}
{"index": 144, "category": "左手指法", "name": "双撞", "explanation": "连撞两次。"}
{"index": 145, "category": "左手指法", "name": "小撞", "explanation": "幅度较小的撞。"}
{"index": 146, "category": "左手指法", "name": "反撞", "explanation": "左手得声后立即注下稍许，然后立即回归本位。"}
{"index": 147, "category": "左手指法", "name": "唤", "explanation": "似撞，但较柔和。"}
{"index": 148, "category": "左手指法", "name": "逗", "explanation": "逗与唤通常不分；有时左手可上滑略高于本位，然后回归。"}
{"index": 149, "category": "左手指法", "name": "上", "explanation": "左手向右移动。"}
{"index": 150, "category": "左手指法", "name": "下", "explanation": "左手向左移动。"}
{"index": 151, "category": "左手指法", "name": "注下", "explanation": "在下滑音中略加吟猱。"}
{"index": 152, "category": "左手指法", "name": "淌", "explanation": "缓缓的下滑音。"}
{"index": 153, "category": "左手指法", "name": "往来", "explanation": "左手在两个不同的音位之间移动数次。"}
{"index": 154, "category": "左手指法", "name": "进复", "explanation": "得音后，左手上下往复一次。"}
{"index": 155, "category": "左手指法", "name": "懒进复", "explanation": "柔缓的进复。"}
{"index": 156, "category": "左手指法", "name": "退复", "explanation": "先下后上，往复一次。"}
{"index": 157, "category": "左手指法", "name": "分开", "explanation": "左手得音后上至某位，然后接弹一声，再回归本位。"}
{"index": 158, "category": "左手指法", "name": "掐起", "explanation": "左手名指按弦，大指拨弦得声。"}
{"index": 159, "category": "左手指法", "name": "对按 / 对按掐起 / 过", "explanation": "均属掐起相关的古写或旧式写法。"}
{"index": 160, "category": "特殊/左右手配合指法", "name": "对起", "explanation": "对起；为对按掐起的另一种写法。"}
{"index": 162, "category": "特殊/左右手配合指法", "name": "抓起/爪起", "explanation": "承接前一个由大指按弦发出的按音，大指甲尖将同一根弦顺势拨起并放开，使该弦转为发出散音；不得换弦，也不得误作保持按位后的再次发声。"}
{"index": 163, "category": "特殊/左右手配合指法", "name": "带起", "explanation": "左手名指向上带弦得声。"}
{"index": 164, "category": "特殊/左右手配合指法", "name": "罨", "explanation": "左手名指按弦，大指在下一音位击弦。"}
{"index": 165, "category": "特殊/左右手配合指法", "name": "虚罨", "explanation": "左手某指在空弦得声后，于另一弦作罨。"}
{"index": 166, "category": "特殊/左右手配合指法", "name": "虚撞", "explanation": "不弹而撞；例如左手按七弦六徽，右手挑弦得声后，滑上六徽二分，再回原位，撞出一声。"}
{"index": 167, "category": "特殊/左右手配合指法", "name": "推出", "explanation": "中指向外斜推出一弦。"}
{"index": 168, "category": "特殊/左右手配合指法", "name": "放合", "explanation": "左手名指向内放空弦，随即按于次弦某一音位；右手同时拨弦一声，形成和音或应合。"}
{"index": 169, "category": "特殊/左右手配合指法", "name": "爪合", "explanation": "左手大指按于某弦后，名指于另一弦拨弦得声，同时大指爪起，形成和音。"}
{"index": 170, "category": "特殊/左右手配合指法", "name": "同声 / 同起", "explanation": "左右两手拨奏不同的两根空弦，同时得声。"}
{"index": 171, "category": "特殊/左右手配合指法", "name": "带合", "explanation": "同声的一种；通常指左手用名指拨弦与右手配合。"}
{"index": 172, "category": "特殊/左右手配合指法", "name": "应合", "explanation": "左手在某一音位向上滑奏的同时，右手以另一弦应之；或有前后相应。"}
{"index": 173, "category": "特殊/左右手配合指法", "name": "浒", "explanation": "左手按弦得音，稍后即引上至下一音位。"}
{"index": 174, "category": "特殊/左右手配合指法", "name": "不动", "explanation": "左手某指保留在前一音位不动，作为后续指法的提示。"}
{"index": 175, "category": "特殊/左右手配合指法", "name": "索铃", "explanation": "左手用一指或数指按弦，右手配合相应拨奏；振索而铃声连响不绝。"}
{"index": 176, "category": "特殊/左右手配合指法", "name": "铃", "explanation": "索铃的一种；用左手大指同时按三条弦，右手在此三弦上快速演奏轮的指法。"}
{"index": 177, "category": "左手指法", "name": "吟滑", "explanation": "承接前一按音，在余音上作吟并带滑动；沿用当前弦、左手按指和音位，不另起右手拨弦。"}
